# PowerChain Token 1.0.0 — production template
# Keep deployment identities, credentials and release authorization blank until
# they are backed by reviewed on-chain/build evidence.

NODE_ENV=production

# ---------------------------------------------------------------------------
# Canonical public identities
# ---------------------------------------------------------------------------
PWRC_CANONICAL_MINT=PWRCRXXZxbg6FdQZfK3PMD7KP8xfxs9acvifJiG46wc
PWRC_TOKEN_VERIFIER_PROGRAM_ID=PWRCpWCpQ8BRn3pzMnvaTzMK9Q2GsxuLx7QgJgduLSu
METAPLEX_TOKEN_METADATA_PROGRAM_ID=metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s

# ---------------------------------------------------------------------------
# Solana Mainnet
# ---------------------------------------------------------------------------
PWRC_CLUSTER=mainnet-beta
PWRC_MAINNET_RPC_URL=
PWRC_RPC_URL_SECONDARY=
PWRC_WS_URL=
PWRC_LOCK_PROGRAM_ID_MAINNET=
PWRC_TOKEN_PROGRAM_ID_MAINNET=

# ---------------------------------------------------------------------------
# Sui Mainnet / wPWRC
# ---------------------------------------------------------------------------
SUI_NETWORK=mainnet
SUI_MAINNET_ENV_ALIAS=
SUI_MAINNET_RPC_URL=
SUI_RPC_URL_SECONDARY=
SUI_WS_URL=
WPWRC_SUI_PACKAGE_ID=
WPWRC_SUI_COIN_TYPE=
WPWRC_SUI_BRIDGE_CONTROLLER_ID=
WPWRC_SUI_METADATA_CAPABILITY_ID=

# ---------------------------------------------------------------------------
# Fees / quote policy
# ---------------------------------------------------------------------------
PWRC_SERVICE_FEE_ENABLED=false
PWRC_SERVICE_FEE_BPS=250
POWERCHAIN_TRANSACTION_FEE_SOLANA=FeeszhrKKEsvxr1kg8LDtPx6BLcEbYHiAThYaxajNhqy
POWERCHAIN_TRANSACTION_FEE_SUI=0xc23c9622a09c5533fd18f35703622dc2df44206749a1761202d2024a04a36f50

PWRC_QUOTE_TTL_MS=30000
PWRC_API_RATE_LIMIT=120

# ---------------------------------------------------------------------------
# Bridge execution — disabled until separately authorized
# ---------------------------------------------------------------------------
PWRC_BRIDGE_EXECUTION_ENABLED=false
PWRC_BRIDGE_EXECUTOR_URL=
PWRC_BRIDGE_EXECUTOR_API_KEY=
PWRC_BRIDGE_API_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Server applications
# Override hosts for the deployment runtime when necessary.
# ---------------------------------------------------------------------------
PWRC_API_HOST=127.0.0.1
PWRC_API_PORT=8787
PWRC_CLIENT_HOST=127.0.0.1
PWRC_CLIENT_PORT=3000
PWRC_CLIENT_API_URL=http://127.0.0.1:8787
PWRC_DOCS_HOST=127.0.0.1
PWRC_DOCS_PORT=3002

# ---------------------------------------------------------------------------
# Coinbase Developer Platform SQL API — server only
# ---------------------------------------------------------------------------
CDP_SQL_API_BEARER_TOKEN=
CDP_SQL_API_TOKEN=
CDP_SQL_API_URL=https://api.cdp.coinbase.com/platform/v2/data/query/run
CDP_SQL_API_TIMEOUT_MS=10000
CDP_SQL_API_CACHE_MAX_AGE_MS=15000

# ---------------------------------------------------------------------------
# Mainnet/release gates — fail closed
# ---------------------------------------------------------------------------
PWRC_MAINNET_ENABLED=false
PWRC_MAINNET_DEPLOY_ENABLED=false
PWRC_MAINNET_DEPLOY_CONFIRMATION=
PWRC_FINALIZATION_ENABLED=false
PWRC_FINALIZATION_CONFIRMATION=
WPWRC_MAINNET_ENABLED=false
WPWRC_MAINNET_CONFIRMATION=
PWRC_RELEASE_CONSUMPTION_CONFIRMATION=
PWRC_RELEASE_CONSUMED_BY=

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
PWRC_REQUEST_TIMEOUT_MS=15000
PWRC_RPC_READ_RETRY_ATTEMPTS=4
PWRC_RPC_READ_RETRY_BASE_DELAY_MS=250
PWRC_RPC_READ_RETRY_MAX_DELAY_MS=4000

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
NEXT_TELEMETRY_DISABLED=1
TURBO_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
# ---------------------------------------------------------------------------
# Coinbase CDP User Wallet — optional browser integration
# Project ID is public configuration; never place CDP API secrets here.
# Configure the matching app origin/domain in CDP Portal.
# ---------------------------------------------------------------------------
POWERCHAIN_CDP_USER_WALLET_ENABLED=false
POWERCHAIN_CDP_PROJECT_ID=
POWERCHAIN_CDP_APP_NAME=PowerChain
