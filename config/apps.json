{
  "version": "1.0.0",
  "api": {
    "defaultHost": "127.0.0.1",
    "defaultPort": 8787,
    "maxJsonBodyBytes": 65536,
    "requestTimeoutMs": 30000,
    "executorTimeoutMs": 20000,
    "executionDefaultEnabled": false,
    "readRateLimitPerMinute": 120,
    "writeRateLimitPerMinute": 30,
    "mainnetStatusCacheMs": 2000,
    "idempotencyDirectory": "runtime/api-idempotency",
    "metricsEnabled": true
  },
  "fullstack": {
    "autoPortsDefault": false,
    "apiHealthPath": "/api/v1/health",
    "startupTimeoutMs": 8000,
    "shutdownTimeoutMs": 5000
  },
  "docs": {
    "host": "127.0.0.1",
    "port": 3002,
    "healthPath": "/health",
    "sessionsEndpoint": "/api/docs/sessions"
  },
  "client": {
    "defaultHost": "127.0.0.1",
    "defaultPort": 3000,
    "apiProxyDefault": "http://127.0.0.1:8787",
    "proxyTimeoutMs": 30000,
    "proxyMaxBodyBytes": 65536
  }
}
