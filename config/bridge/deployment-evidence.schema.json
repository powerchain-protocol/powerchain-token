{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://token.powerchain.energy/schemas/bridge-deployment-evidence.schema.json",
  "title": "PowerChain Bridge Deployment Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "network",
    "canonicalChain",
    "wrappedChain",
    "canonicalDecimals",
    "wrappedDecimals",
    "conversionFactor",
    "sourceProgramId",
    "suiPackageId",
    "bridgeControllerId",
    "coinType",
    "sha256"
  ],
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "network": {
      "enum": [
        "testnet",
        "mainnet"
      ]
    },
    "canonicalChain": {
      "const": "solana"
    },
    "wrappedChain": {
      "const": "sui"
    },
    "canonicalDecimals": {
      "const": 9
    },
    "wrappedDecimals": {
      "const": 6
    },
    "conversionFactor": {
      "const": "1000"
    },
    "sourceProgramId": {
      "type": "string",
      "minLength": 32
    },
    "suiPackageId": {
      "type": "string",
      "pattern": "^0x[a-f0-9]{64}$"
    },
    "bridgeControllerId": {
      "type": "string",
      "pattern": "^0x[a-f0-9]{64}$"
    },
    "coinType": {
      "type": "string",
      "minLength": 10
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
