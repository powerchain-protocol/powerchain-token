{
  "version": "1.0.0",
  "solana": {
    "commitment": "finalized",
    "minimumConfirmationsPolicy": "finalized",
    "lockReceiptRequired": true,
    "transactionMustContainExpectedProgram": true,
    "instructionIndexMustMatchClaim": true
  },
  "sui": {
    "checkpointFinalityRequired": true,
    "burnEventRequired": true,
    "bridgeControllerRequired": true,
    "packageAndCoinTypeMustMatchDeployment": true
  },
  "crossChain": {
    "idempotent": true,
    "oneDestinationMintPerSolanaLockReceipt": true,
    "oneSolanaReleasePerSuiBurnReference": true,
    "reconciliationRequiredBeforeRetry": true,
    "manualReviewOnProviderDisagreement": true
  }
}
