{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://token.powerchain.energy/schemas/quarterly-burn-record.schema.json",
  "title": "PowerChain Quarterly Burn Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "burnId",
    "quarterId",
    "plannedBurnBaseUnits",
    "preBurnSupplyBaseUnits",
    "postBurnSupplyBaseUnits",
    "planSha256",
    "journalHeadSha256",
    "state"
  ],
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "burnId": {
      "type": "string",
      "minLength": 1
    },
    "quarterId": {
      "type": "string",
      "pattern": "^[0-9]{5}$"
    },
    "plannedBurnBaseUnits": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "preBurnSupplyBaseUnits": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "postBurnSupplyBaseUnits": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "solanaSignature": {
      "type": [
        "string",
        "null"
      ]
    },
    "suiCeilingDigest": {
      "type": [
        "string",
        "null"
      ]
    },
    "planSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "journalHeadSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "enum": [
        "PLANNED",
        "PRECHECKED",
        "SOLANA_SIMULATED",
        "SOLANA_SUBMITTED",
        "SOLANA_FINALIZED",
        "SUI_BRIDGE_PAUSED",
        "SUI_CEILING_SUBMITTED",
        "SUI_CEILING_FINALIZED",
        "RECONCILED",
        "COMPLETED",
        "BLOCKED"
      ]
    }
  }
}
