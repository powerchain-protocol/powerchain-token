{
  "version": "1.0.0",
  "provider": "coinbase-cdp-hooks-provider",
  "optional": true,
  "defaultEnabled": false,
  "solana": {
    "createOnLogin": true,
    "supportedNetworks": [
      "solana-mainnet",
      "solana-devnet"
    ]
  },
  "ethereum": {
    "createOnLogin": false
  },
  "analytics": {
    "disabledByDefault": true
  },
  "security": {
    "projectIdIsPublicConfiguration": true,
    "serverBearerTokenMustNeverBeReused": true,
    "productionDomainAllowlistRequired": true,
    "localhostForbiddenInProductionProject": true
  },
  "packages": {
    "@coinbase/cdp-core": "0.0.120",
    "@coinbase/cdp-hooks": "0.0.120"
  },
  "uiMode": "custom-hooks"
}
