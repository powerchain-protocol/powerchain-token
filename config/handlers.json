{
  "version": "1.0.0",
  "handlers": {
    "read": {
      "retry": true,
      "timeoutMs": 10000
    },
    "write": {
      "retry": false,
      "simulate": true,
      "finalizedConfirmation": true
    },
    "bridge": {
      "replayReserveRequired": true,
      "identityCheckRequired": true,
      "conservationCheckRequired": true
    }
  },
  "errors": {
    "includeCauseInLogs": true,
    "exposeInternalCauseToCaller": false,
    "redactSecrets": true
  }
}
