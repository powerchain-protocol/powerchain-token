{
  "version": "1.0.0",
  "evidence": {
    "hashAlgorithm": "sha256",
    "hashChained": true,
    "persistQuotes": true,
    "persistFinalizedTransactions": true,
    "persistProviderObservations": true
  },
  "providerHealth": {
    "windowSize": 100,
    "states": [
      "healthy",
      "degraded",
      "unhealthy",
      "unknown"
    ],
    "failClosedForSettlement": true
  },
  "readRetries": {
    "maxAttempts": 3,
    "baseDelayMs": 250,
    "maxDelayMs": 2000,
    "retryableStatusCodes": [
      408,
      425,
      429,
      500,
      502,
      503,
      504
    ],
    "writesAutomaticallyRetried": false
  },
  "logging": {
    "privateKeys": "forbidden",
    "seedPhrases": "forbidden",
    "rawAuthorizationHeaders": "forbidden",
    "fullPrompts": "forbidden-by-default"
  }
}
