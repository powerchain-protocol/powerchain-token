    "deploymentEvidenceRequired": true
  },
  "release": {
    "typecheckRequired": true,
    "testsRequired": true,
    "anchorBuildRequired": true,
    "suiBuildRequired": true,
    "mainnetPreflightRequired": true
  }
}
