{
  "version": "1.0.0",
  "environment": "production",
  "mainnetFailClosed": true,
  "solana": {
    "commitment": "finalized",
    "dedicatedRpcRequired": true,
    "secondaryRpcRequiredForRelease": true,
    "publicRpcAllowed": false
  },
  "sui": {
    "network": "mainnet",
    "rpcUrl": "https://fullnode.mainnet.sui.io:443",
    "move2024PackageManager": true,
    "moveLockRequired": true,
