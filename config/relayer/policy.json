{
  "version": "1.0.0",
  "mode": "fail-closed",
  "roles": {
    "observer": "reads source/destination chain state only",
    "verifier": "validates finality, receipts, amounts, identities and conservation",
    "submitter": "submits pre-authorized destination transaction",
    "governor": "never embedded in relayer"
  },
  "separation": {
    "observerAndSubmitterMayShareProcess": false,
    "verifierAndGovernorMayShareKey": false,
    "aiWorkerMayHoldSigningKey": false,
    "privateKeysInLogs": false
  },
  "queue": {
    "idempotencyKeyRequired": true,
    "maxAttempts": 3,
    "deadLetterAfterMaxAttempts": true,
    "retryWritesBlindly": false,
    "maxSize": 1000,
    "hardBackpressure": true,
    "duplicateIdRejected": true
  },
  "finality": {
    "solana": "finalized",
    "sui": "checkpoint-confirmed"
  },
  "providerPolicy": {
    "minimumIndependentSolanaObservers": 2,
    "providerDisagreement": "block-and-review",
    "externalProviderAuthoritative": false
  },
  "conservation": {
    "checkBeforeDestinationSubmit": true,
    "checkAfterDestinationFinality": true,
    "haltOnExposureViolation": true
  },
  "replay": {
    "domainSeparated": true,
    "networkBound": true,
    "versionBound": true,
    "persistBeforeDestinationMutation": true
  },
  "serialization": {
    "canonicalJson": true,
    "sha256Evidence": true,
    "bigintSerializedAsDecimalString": true
  }
}
