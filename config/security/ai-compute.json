{
  "version": "1.0.0",
  "enabled": true,
  "jobTtlSeconds": 300,
  "maxJobTtlSeconds": 900,
  "maxPromptBytes": 128000,
  "maxOutputTokens": 32768,
  "maxToolCalls": 32,
  "maxParallelTools": 4,
  "security": {
    "signedJobTickets": true,
    "nonceRequired": true,
    "promptHashRequired": true,
    "serverSideBudgetEnforcement": true,
    "toolAllowlistRequired": true,
    "privateKeysInPromptsForbidden": true,
    "walletSigningDelegatedToModel": false,
    "arbitraryShellExecution": false,
    "networkEgressDefaultDeny": true
  }
}
