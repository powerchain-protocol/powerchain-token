{
  "version": "1.0.0",
  "apps": {
    "api": {
      "path": "apps/api",
      "port": 8787
    },
    "client": {
      "path": "apps/client",
      "port": 3000
    },
    "docs": {
      "path": "apps/docs",
      "port": 3002
    }
  },
  "runtime": {
    "autoPorts": true,
    "apiBeforeClient": true,
    "startupTimeoutMs": 8000,
    "shutdownTimeoutMs": 5000
  },
  "security": {
    "serverOwnedWrites": true,
    "blindMonetaryWriteRetry": false,
    "mainnetFailClosed": true
  },
  "toolchain": {
    "node": "26.5.1",
    "nvm": "0.40.6",
    "npm": "11.17.0",
    "pnpm": "11.18.0",
    "typescript": "7.0.2"
  }
}
