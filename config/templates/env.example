# PowerChain Token 1.0.0 — safe environment template
#
# Copy this file:
#   cp .env.example .env
#
# Do not commit real secrets, private keys, API keys, mnemonics,
# bearer tokens, release-signing material or deployer keypairs.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# Canonical PWRC
# ---------------------------------------------------------------------------
PWRC_CANONICAL_MINT=PWRCRXXZxbg6FdQZfK3PMD7KP8xfxs9acvifJiG46wc

# Stable verifier source identity.
PWRC_TOKEN_VERIFIER_PROGRAM_ID=PWRCpWCpQ8BRn3pzMnvaTzMK9Q2GsxuLx7QgJgduLSu

# Official Metaplex Token Metadata program.
METAPLEX_TOKEN_METADATA_PROGRAM_ID=metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s

# ---------------------------------------------------------------------------
# Solana network
# localnet | devnet | mainnet-beta
# ---------------------------------------------------------------------------
PWRC_CLUSTER=localnet

# Primary RPC used by application reads.
PWRC_RPC_URL=http://127.0.0.1:8899

# Optional independent verification/fallback RPC.
PWRC_RPC_URL_SECONDARY=

# Optional WebSocket endpoint.
PWRC_WS_URL=

# Dedicated Mainnet RPC. Required in production Mainnet mode.
PWRC_MAINNET_RPC_URL=

# Optional Devnet RPC override.
PWRC_DEVNET_RPC_URL=https://api.devnet.solana.com

# ---------------------------------------------------------------------------
# Solana program IDs
# ---------------------------------------------------------------------------
PWRC_LOCK_PROGRAM_ID_LOCALNET=7JAV3PsxkHh5oKAFDMKqVpKaV2P2P5Vj3Qv15hH8wPwr
PWRC_TOKEN_PROGRAM_ID_LOCALNET=PWRCpWCpQ8BRn3pzMnvaTzMK9Q2GsxuLx7QgJgduLSu

# Devnet lock ID remains blank until a real reviewed deployment exists.
PWRC_LOCK_PROGRAM_ID_DEVNET=
PWRC_TOKEN_PROGRAM_ID_DEVNET=PWRCpWCpQ8BRn3pzMnvaTzMK9Q2GsxuLx7QgJgduLSu

# Mainnet IDs remain blank until build/deployment/evidence qualification.
PWRC_LOCK_PROGRAM_ID_MAINNET=
PWRC_TOKEN_PROGRAM_ID_MAINNET=

# ---------------------------------------------------------------------------
# Solana signer / program keypair paths — server/CLI only
# Never place private key material directly in env values.
# ---------------------------------------------------------------------------
PWRC_TOKEN_PROGRAM_KEYPAIR=
PWRC_LOCK_PROGRAM_KEYPAIR=

PWRC_DEVNET_DEPLOYER_KEYPAIR=
PWRC_MAINNET_DEPLOYER_KEYPAIR=

# ---------------------------------------------------------------------------
# Devnet deployment gates
# ---------------------------------------------------------------------------
PWRC_DEVNET_DEPLOY_ENABLED=false

# ---------------------------------------------------------------------------
# Mainnet Solana deployment gates
# ---------------------------------------------------------------------------
PWRC_MAINNET_DEPLOY_ENABLED=false
PWRC_MAINNET_DEPLOY_CONFIRMATION=

# ---------------------------------------------------------------------------
# Sui / wPWRC
# localnet | devnet | testnet | mainnet
# ---------------------------------------------------------------------------
SUI_NETWORK=devnet

SUI_RPC_URL=https://fullnode.devnet.sui.io:443
SUI_RPC_URL_SECONDARY=
SUI_WS_URL=

SUI_MAINNET_RPC_URL=
SUI_DEVNET_ENV_ALIAS=devnet
SUI_MAINNET_ENV_ALIAS=

# Configured PowerChain alias/address.
WPWRC_SUI_ALIAS=powerchain
WPWRC_SUI_ALIAS_ADDRESS=0x4a4a81c5e4a520c1b4d7b5b572a0567f48c6c7e85257f0a13e65639cfba49fb1

# Actual published package/object identities.
# Keep blank until real publish evidence exists.
WPWRC_SUI_PACKAGE_ID=
WPWRC_SUI_COIN_TYPE=
WPWRC_SUI_BRIDGE_CONTROLLER_ID=
WPWRC_SUI_METADATA_CAPABILITY_ID=

# ---------------------------------------------------------------------------
# Sui publish gates
# ---------------------------------------------------------------------------
WPWRC_DEVNET_PUBLISH_ENABLED=false
WPWRC_MAINNET_ENABLED=false
WPWRC_MAINNET_CONFIRMATION=

# ---------------------------------------------------------------------------
# PowerChain service fee
#
# PWRC already has a native Token-2022 2.5% transfer fee.
# This service fee is a separate operation-level fee and is disabled by default.
# ---------------------------------------------------------------------------
PWRC_SERVICE_FEE_ENABLED=false
PWRC_SERVICE_FEE_BPS=250
POWERCHAIN_TRANSACTION_FEE_SOLANA=FeeszhrKKEsvxr1kg8LDtPx6BLcEbYHiAThYaxajNhqy
POWERCHAIN_TRANSACTION_FEE_SUI=0xc23c9622a09c5533fd18f35703622dc2df44206749a1761202d2024a04a36f50


# Quote validity and API protection.
PWRC_QUOTE_TTL_MS=30000
PWRC_API_RATE_LIMIT=120

# ---------------------------------------------------------------------------
# Bridge execution
# Disabled by default. Browser code must never receive executor credentials.
# ---------------------------------------------------------------------------
PWRC_BRIDGE_EXECUTION_ENABLED=false
PWRC_BRIDGE_EXECUTOR_URL=
PWRC_BRIDGE_EXECUTOR_API_KEY=
PWRC_BRIDGE_API_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Coinbase Developer Platform SQL API — server only
#
# Used for indexed Solana Mainnet PWRC analytics/history.
# Not authoritative for bridge settlement or Mainnet release evidence.
# ---------------------------------------------------------------------------
CDP_SQL_API_BEARER_TOKEN=
CDP_SQL_API_TOKEN=
CDP_SQL_API_URL=https://api.cdp.coinbase.com/platform/v2/data/query/run
CDP_SQL_API_TIMEOUT_MS=10000
CDP_SQL_API_CACHE_MAX_AGE_MS=15000

# ---------------------------------------------------------------------------
# Applications
# Preferred local ports:
# API    8787
# Client 3000
# Docs   3002
# ---------------------------------------------------------------------------
PWRC_API_HOST=127.0.0.1
PWRC_API_PORT=8787

PWRC_CLIENT_HOST=127.0.0.1
PWRC_CLIENT_PORT=3000
PWRC_CLIENT_API_URL=http://127.0.0.1:8787

PWRC_DOCS_HOST=127.0.0.1
PWRC_DOCS_PORT=3002

# Allow local full-stack supervisor to find another free loopback port.
PWRC_FULLSTACK_AUTO_PORTS=true

# ---------------------------------------------------------------------------
# Release / finalization gates
# ---------------------------------------------------------------------------
PWRC_MAINNET_ENABLED=false
PWRC_FINALIZATION_ENABLED=false
PWRC_FINALIZATION_CONFIRMATION=

# One-time authorization consumption.
PWRC_RELEASE_CONSUMPTION_CONFIRMATION=
PWRC_RELEASE_CONSUMED_BY=

# ---------------------------------------------------------------------------
# Optional runtime tuning
# ---------------------------------------------------------------------------
PWRC_REQUEST_TIMEOUT_MS=15000
PWRC_RPC_READ_RETRY_ATTEMPTS=4
PWRC_RPC_READ_RETRY_BASE_DELAY_MS=250
PWRC_RPC_READ_RETRY_MAX_DELAY_MS=4000

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
NEXT_TELEMETRY_DISABLED=1
TURBO_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
# ---------------------------------------------------------------------------
# Coinbase CDP User Wallet — optional browser integration
# Project ID is public configuration; never place CDP API secrets here.
# Configure the matching app origin/domain in CDP Portal.
# ---------------------------------------------------------------------------
POWERCHAIN_CDP_USER_WALLET_ENABLED=false
POWERCHAIN_CDP_PROJECT_ID=
POWERCHAIN_CDP_APP_NAME=PowerChain
POWERCHAIN_PROXY_ENABLED=false
POWERCHAIN_PROXY_ALLOWED_HOSTS=
POWERCHAIN_PROXY_TIMEOUT_MS=10000
POWERCHAIN_WS_PROXY_ENABLED=false
POWERCHAIN_WS_PROXY_ALLOWED_HOSTS=
POWERCHAIN_WS_HEARTBEAT_MS=30000
