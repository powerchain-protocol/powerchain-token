# PowerChain wPWRC Mainnet package template for the current Sui Move package
# manager. The Sui framework is resolved by the Sui toolchain for edition 2024;
# do not add an explicit Sui git dependency here.
#
# Run the reviewed Sui build to generate Move.lock, then preserve the Move.lock
# SHA-256 and Sui CLI version as release/deployment evidence.

[package]
name = "wpwrc"
version = "1.0.0"
edition = "2024"

[addresses]
wpwrc = "0x0"
