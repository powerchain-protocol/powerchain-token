{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "powerchain://idl/anchor/pwrc_lock.schema.json",
  "title": "PowerChain pwrc_lock Anchor IDL",
  "type": "object",
  "required": [
    "address",
    "metadata",
    "instructions"
  ],
  "properties": {
    "address": {
      "type": "string",
      "minLength": 32
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "version",
        "spec"
      ],
      "properties": {
        "name": {
          "const": "pwrc_lock"
        },
        "version": {
          "const": "1.0.0"
        },
        "spec": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "instructions": {
      "type": "array",
      "minItems": 10
    },
    "accounts": {
      "type": "array"
    },
    "events": {
      "type": "array"
    },
    "errors": {
      "type": "array"
    },
    "types": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
