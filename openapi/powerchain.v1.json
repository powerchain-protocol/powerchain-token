{
  "openapi": "3.1.0",
  "info": {
    "title": "PowerChain Platform API",
    "version": "1.0.0",
    "description": "Readiness, canonical PWRC profile, fee-aware bridge quotes, and fail-closed bridge execution adapter."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Service health"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/v1/ready": {
      "get": {
        "responses": {
          "200": {
            "description": "Code/runtime readiness"
          },
          "503": {
            "description": "Code not ready"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/v1/version": {
      "get": {
        "responses": {
          "200": {
            "description": "API version"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/v1/token": {
      "get": {
        "responses": {
          "200": {
            "description": "Canonical PWRC profile"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/v1/mainnet/status": {
      "get": {
        "responses": {
          "200": {
            "description": "Fail-closed Mainnet release status"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/v1/bridge/capabilities": {
      "get": {
        "responses": {
          "200": {
            "description": "Bridge quote/execution capability"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/v1/bridge/quote": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "direction",
                  "amountBaseUnits"
                ],
                "properties": {
                  "direction": {
                    "enum": [
                      "solana-to-sui",
                      "sui-to-solana"
                    ]
                  },
                  "amountBaseUnits": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server-owned Token-2022 fee-aware quote"
          },
          "400": {
            "description": "Invalid quote input"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/v1/bridge/execute": {
      "post": {
        "description": "Server-to-server execution only. Mainnet readiness, bearer authorization, idempotency key, and executor configuration are all required.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "direction",
                  "amountBaseUnits",
                  "destinationAddress",
                  "quoteFingerprint"
                ],
                "properties": {
                  "direction": {
                    "enum": [
                      "solana-to-sui",
                      "sui-to-solana"
                    ]
                  },
                  "amountBaseUnits": {
                    "type": "string"
                  },
                  "quoteFingerprint": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{64}$"
                  },
                  "destinationAddress": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Execution accepted by configured signer/executor"
          },
          "401": {
            "description": "Execution authorization failed"
          },
          "409": {
            "description": "Quote mismatch, idempotency conflict, prior failure, or reconciliation required"
          },
          "503": {
            "description": "Mainnet or executor not ready"
          },
          "504": {
            "description": "Executor result ambiguous due timeout"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/v1/metrics": {
      "get": {
        "responses": {
          "200": {
            "description": "Process-local health counters"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    },
    "/api/v1/bridge/executions/{idempotencyKey}": {
      "get": {
        "description": "Authenticated execution reconciliation/status lookup.",
        "parameters": [
          {
            "name": "idempotencyKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Durable execution record"
          },
          "401": {
            "description": "Authorization failed"
          },
          "404": {
            "description": "Execution record not found"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
