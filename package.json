{
  "name": "@powerchain/pwrc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.14.0 <25"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "pwrc:doctor": "bash scripts/doctor.sh",
    "pwrc:devnet:prepare": "PWRC_CLUSTER=devnet bash scripts/prepare.sh",
    "pwrc:devnet:deploy": "PWRC_CLUSTER=devnet bash scripts/deploy.sh",
    "pwrc:devnet:verify": "PWRC_CLUSTER=devnet bash scripts/verify.sh",
    "pwrc:devnet:finalize": "PWRC_CLUSTER=devnet bash scripts/finalize.sh",
    "pwrc:mainnet:prepare": "PWRC_CLUSTER=mainnet-beta bash scripts/prepare.sh",
    "pwrc:mainnet:deploy": "PWRC_CLUSTER=mainnet-beta bash scripts/deploy.sh",
    "pwrc:mainnet:verify": "PWRC_CLUSTER=mainnet-beta bash scripts/verify.sh",
    "pwrc:mainnet:finalize": "PWRC_CLUSTER=mainnet-beta bash scripts/finalize.sh",
    "pwrc:proof": "tsx scripts/proof.ts",
    "pwrc:policy": "tsx scripts/check-policy.ts",
    "pwrc:metadata": "tsx scripts/check-metadata.ts",
    "pwrc:versions": "tsx scripts/check-version.ts",
    "pwrc:status": "bash scripts/status.sh",
    "pwrc:snapshot": "bash scripts/snapshot.sh",
    "pwrc:release": "tsx scripts/release.ts",
    "ci": "pnpm pwrc:versions && pnpm pwrc:policy && pnpm pwrc:metadata && pnpm pwrc:bridge && pnpm pwrc:fees && pnpm pwrc:program:static && pnpm pwrc:integrations && pnpm pwrc:market && pnpm check && pnpm test && pnpm test:anchor",
    "pwrc:toolchain": "node scripts/check-toolchain.mjs",
    "pwrc:seal": "node scripts/seal-inputs.mjs",
    "pwrc:journal": "node scripts/verify-journal.mjs deployments/${PWRC_CLUSTER:-devnet}/journal.jsonl",
    "pwrc:lockfile": "node scripts/check-lockfile.mjs",
    "test:anchor": "node --import tsx --test tests/anchor.test.ts",
    "pwrc:client:test": "node --import tsx --test tests/anchor.test.ts",
    "pwrc:bridge": "tsx scripts/check-bridge.ts",
    "pwrc:fees": "tsx scripts/check-fees.ts",
    "program:build": "anchor build",
    "program:test": "cargo test -p pwrc-fees",
    "program:id": "anchor keys list",
    "pwrc:program:static": "node scripts/check-program-static.mjs",
    "pwrc:integrations": "tsx scripts/check-integrations.ts",
    "pwrc:market": "tsx scripts/check-market.ts",
    "pwrc:readiness": "tsx scripts/check-readiness.ts",
    "pwrc:operations": "tsx scripts/check-operations.ts",
    "pwrc:sui:bridge": "tsx scripts/check-sui-bridge.ts",
    "wpwrc:build": "bash scripts/sui/build.sh",
    "wpwrc:testnet:deploy": "bash scripts/sui/deploy-testnet.sh",
    "wpwrc:mainnet:deploy": "bash scripts/sui/deploy-mainnet.sh",
    "wpwrc:finalize-registration": "bash scripts/sui/finalize-registration.sh",
    "wpwrc:manifest": "node scripts/sui/write-deployment-manifest.mjs"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@solana/web3.js": "1.98.4",
    "axios": "1.19.0",
    "bs58": "6.0.0",
    "@solana/spl-token": "0.4.15",
    "tweetnacl": "1.0.3",
    "@mysten/sui": "2.23.1"
  },
  "exports": {
    "./client": "./client/client.ts",
    "./constants": "./src/constants.ts",
    "./amounts": "./src/amounts.ts",
    "./policy": "./src/policy.ts",
    "./bridge": "./src/bridge.ts",
    "./client/bridge": "./client/bridge.ts",
    "./client/metadata": "./client/metadata.ts",
    "./fees": "./src/fees.ts",
    "./programs": "./client/programs.ts",
    "./client/transactions": "./client/transactions.ts",
    "./ai": "./src/ai/policy.ts",
    "./ai/job-token": "./src/ai/job-token.ts",
    "./x402": "./src/x402/policy.ts",
    "./client/x402": "./client/x402/client.ts",
    "./cctp": "./src/cctp/policy.ts",
    "./client/cctp": "./client/cctp/client.ts",
    "./zk": "./src/zk/policy.ts",
    "./market": "./src/market/policy.ts",
    "./client/market": "./client/market/index.ts",
    "./market/risk": "./src/market/risk.ts",
    "./market/quote": "./src/market/quote.ts",
    "./observability/health": "./src/observability/health.ts",
    "./observability/evidence": "./src/observability/evidence.ts",
    "./observability/retry": "./src/observability/retry.ts",
    "./client/observability": "./client/observability/read-retry.ts",
    "./readiness": "./src/readiness.ts",
    "./operations": "./src/operations/policy.ts",
    "./operation-ids": "./src/operations/ids.ts",
    "./client/signed-message": "./client/signed-message.ts",
    "./client/sui": "./client/sui/index.ts",
    "./client/sui/verify": "./client/sui/verify.ts",
    "./sui-bridge-integrity": "./src/sui-bridge-integrity.ts"
  }
}
