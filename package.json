{
  "name": "@powerchain/pwrc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PowerChain PWRC canonical Token-2022 protocol, bridge, clients, programs, contracts and production tooling.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/powerchain-protocol/powerchain-token.git"
  },
  "bugs": {
    "url": "https://github.com/powerchain-protocol/powerchain-token/issues"
  },
  "homepage": "https://github.com/powerchain-protocol/powerchain-token#readme",
  "packageManager": "pnpm@10.21.0",
  "engines": {
    "node": ">=22.22.3 <23 || >=24.18.1 <25 || >=26.5.1 <27"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm test && pnpm production:check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "production:check": "node scripts/production/check-all.mjs",
    "fees:check": "node scripts/production/check-fees.mjs",
    "config:check": "node scripts/production/check-config.mjs",
    "stack:check": "node scripts/production/check-stack.mjs",
    "app:api": "node apps/api/server.mjs",
    "app:client": "node apps/client/server.mjs",
    "app:docs": "node apps/docs/server.mjs",
    "start": "node scripts/fullstack/start.mjs",
    "start:strict": "node scripts/fullstack/start.mjs --strict-ports",
    "mainnet:status": "node scripts/mainnet/status.mjs",
    "mainnet:launch:plan": "node scripts/mainnet/launch-plan.mjs",
    "program:build:token": "anchor build --program-name pwrc_token",
    "program:build:lock": "anchor build --program-name pwrc_lock",
    "program:test": "cargo test --workspace",
    "security:dependencies": "node scripts/security/check-dependencies.mjs",
    "network:status": "node scripts/network/status.mjs",
    "rpc:check:solana:devnet": "node scripts/network/check-rpc.mjs solana https://api.devnet.solana.com",
    "rpc:check:sui:devnet": "node scripts/network/check-rpc.mjs sui https://fullnode.devnet.sui.io:443",
    "devnet:preflight": "node scripts/devnet/preflight.mjs",
    "devnet:deploy:solana": "bash scripts/devnet/deploy-solana.sh",
    "mainnet:preflight": "node scripts/mainnet/preflight.mjs",
    "mainnet:deploy:solana": "bash scripts/mainnet/deploy-solana.sh",
    "mainnet:verify:solana": "bash scripts/mainnet/verify-solana.sh",
    "mainnet:verify:evidence": "node scripts/mainnet/verify-evidence.mjs",
    "mainnet:verify:authorization": "node scripts/mainnet/verify-release-authorization.mjs",
    "sui:publish:devnet": "bash scripts/sui/publish-devnet.sh",
    "sui:publish:mainnet": "bash scripts/sui/publish-mainnet.sh",
    "program:build:verifiable:token": "anchor build --program-name pwrc_token --verifiable",
    "program:build:verifiable:lock": "anchor build --program-name pwrc_lock --verifiable",
    "mainnet:build:verifiable": "pnpm program:build:verifiable:token && pnpm program:build:verifiable:lock",
    "sui:verify:devnet": "node scripts/sui/verify-deployment.mjs devnet",
    "sui:verify:mainnet": "node scripts/sui/verify-deployment.mjs mainnet",
    "devnet:status": "node scripts/devnet/status.mjs",
    "mainnet:build-manifest": "node scripts/mainnet/generate-build-manifest.mjs",
    "env:check": "node scripts/production/check-env.mjs",
    "canonical:check": "node scripts/production/check-canonical-drift.mjs",
    "devnet:verify:evidence": "node scripts/devnet/verify-evidence.mjs",
    "api:check": "node scripts/production/test-api-hardening.mjs",
    "release:bindings:check": "node scripts/production/check-release-bindings.mjs",
    "mainnet:verify:build-manifest": "node scripts/mainnet/verify-build-manifest.mjs",
    "mainnet:consume:authorization": "node scripts/mainnet/consume-release-authorization.mjs",
    "mainnet:verify:consumption": "node scripts/mainnet/verify-release-consumption.mjs",
    "bridge:trace:check": "node scripts/production/test-bridge-trace.mjs",
    "cdp:check": "node scripts/production/test-cdp-solana-sql.mjs",
    "cdp:policy:check": "node scripts/production/check-cdp-solana-data.mjs",
    "openapi:check": "node scripts/production/check-openapi.mjs",
    "api:endpoints:check": "node scripts/production/test-api-endpoints.mjs",
    "pnpm:check": "node scripts/packages/check-pnpm-build-policy.mjs",
    "monorepo:check": "node scripts/packages/check-monorepo-layout.mjs",
    "telemetry:check": "node scripts/telemetry/check-disabled.mjs",
    "metaplex:check": "node scripts/production/check-metaplex.mjs",
    "idl:binding:check": "node scripts/production/check-idl-binding.mjs",
    "platform:bootstrap:check": "node scripts/production/check-platform-bootstrap.mjs",
    "production:portable:check": "node scripts/production/test-portable-production-checks.mjs",
    "monorepo:clean:dry-run": "node scripts/packages/cleanup-stale-root-source.mjs",
    "monorepo:clean": "node scripts/packages/cleanup-stale-root-source.mjs --apply",
    "workspace:doctor": "node scripts/packages/workspace-doctor.mjs"
  },
  "dependencies": {
    "@anchor-lang/core": "1.0.2",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "axios": "1.19.0",
    "bs58": "6.0.0",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
