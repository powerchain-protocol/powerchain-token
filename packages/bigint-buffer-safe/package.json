{
  "name": "bigint-buffer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PowerChain memory-safe compatibility replacement for bigint-buffer.",
  "license": "UNLICENSED",
  "sideEffects": false,
  "powerchainSafeShim": true,
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
