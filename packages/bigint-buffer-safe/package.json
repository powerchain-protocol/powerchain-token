  "dependencies": {
    "buffer": "6.0.3"
  },
  "engines": {
    "node": ">=22.22.3 <23 || >=24.18.1 <25 || >=26.5.1 <27",
    "pnpm": "10.21.0"
  },
  "scripts": {
    "check": "node test.mjs"
  }
}
