{
  "name": "@powerchain/bridge-integration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.14.0 <25"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./finality": "./src/finality.ts",
    "./reconcile": "./src/reconcile.ts",
    "./mainnet": "./src/mainnet.ts"
  },
  "dependencies": {
    "@powerchain/native-token-client": "workspace:*"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
