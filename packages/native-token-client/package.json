{
  "name": "@powerchain/native-token-client",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants.ts",
    "./amounts": "./src/amounts.ts",
    "./types": "./src/types/index.ts",
    "./validation/solana": "./src/validation/solana.ts",
    "./validation/sui": "./src/validation/sui.ts",
    "./solana/rpc": "./src/solana/rpc.ts",
    "./solana/mint": "./src/solana/mint.ts",
    "./solana/transfer": "./src/solana/transfer.ts",
    "./sui/client": "./src/sui/client.ts",
    "./bridge": "./src/bridge/index.ts",
    "./explorer": "./src/explorer.ts",
    "./common": "./src/common.ts",
    "./utils": "./src/utils.ts",
    "./fees": "./src/fees.ts"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4",
    "axios": "1.19.0",
    "bs58": "6.0.0"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.22.3 <23 || >=24.18.1 <25 || >=26.5.1 <27",
    "pnpm": "10.21.0"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "files": [
    "src",
    "README.md",
    "package.json"
  ]
